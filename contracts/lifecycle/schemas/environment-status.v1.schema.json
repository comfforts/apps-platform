{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:comfforts:app-platform:lifecycle:environment-status:v1",
  "title": "Environment Status Version 1",
  "description": "Truthful non-secret reconciliation of one Platform Environment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "document_kind",
    "environment",
    "profile_digest",
    "source_authority",
    "source_revision",
    "specification_digest",
    "journal_digest",
    "lifecycle_state",
    "last_closed_stage",
    "blockers",
    "qualification_status"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "document_kind": {"const": "environment-status"},
    "environment": {"enum": ["production", "staging"]},
    "profile_digest": {"$ref": "#/$defs/digest"},
    "source_authority": {
      "oneOf": [
        {"type": "null"},
        {"enum": ["accepted", "candidate"]}
      ]
    },
    "source_revision": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sourceRevision"}]
    },
    "specification_digest": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
    },
    "journal_digest": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
    },
    "lifecycle_state": {
      "enum": [
        "absent",
        "blocked",
        "cancelled",
        "deployed",
        "deploying",
        "destroying",
        "destroyed",
        "failed",
        "qualifying",
        "updating",
        "waiting"
      ]
    },
    "last_closed_stage": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/name"}]
    },
    "blockers": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 96,
        "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
      }
    },
    "qualification_status": {
      "enum": ["failed", "not-run", "qualified", "unqualified"]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    }
  }
}
