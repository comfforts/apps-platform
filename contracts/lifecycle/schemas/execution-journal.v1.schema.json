{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:comfforts:app-platform:lifecycle:execution-journal:v1",
  "title": "Execution Journal Version 1",
  "description": "Machine-generated append-only progress for one exact Deployment Specification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "document_kind",
    "environment",
    "operation",
    "source_revision",
    "specification_digest",
    "journal_revision",
    "previous_journal_digest",
    "status",
    "entries"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "document_kind": {"const": "execution-journal"},
    "environment": {"enum": ["production", "staging"]},
    "operation": {"enum": ["deploy", "destroy", "qualify"]},
    "source_revision": {"$ref": "#/$defs/sourceRevision"},
    "specification_digest": {"$ref": "#/$defs/digest"},
    "journal_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "previous_journal_digest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/digest"}
      ]
    },
    "status": {
      "enum": ["cancelled", "failed", "running", "succeeded", "waiting"]
    },
    "entries": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[ -~]+$"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "stage_id",
        "stage_input_digest",
        "outcome",
        "plan_digest",
        "outputs",
        "manual_acknowledgement"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "stage_id": {"$ref": "#/$defs/name"},
        "stage_input_digest": {"$ref": "#/$defs/digest"},
        "outcome": {
          "enum": ["cancelled", "failed", "succeeded", "waiting"]
        },
        "plan_digest": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/digest"}
          ]
        },
        "outputs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/output"}
        },
        "manual_acknowledgement": {
          "enum": ["not-required", "operator-attested", "provider-verified"]
        }
      }
    }
  }
}
