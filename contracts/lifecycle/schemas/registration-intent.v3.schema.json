{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:comfforts:app-platform:lifecycle:registration-intent:v3",
  "title": "Registration Intent Version 3",
  "description": "Reviewed application registration choices for one required root and a complete optional additional attachment set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "document_kind",
    "application_id",
    "access_mode",
    "identity_delivery",
    "catalogue_visibility",
    "catalogue_title",
    "catalogue_summary",
    "attachment_id",
    "mount_path",
    "forwarding_mode"
  ],
  "properties": {
    "contract_version": {"const": 3},
    "document_kind": {"const": "registration-intent"},
    "application_id": {"$ref": "#/$defs/applicationId"},
    "access_mode": {"enum": ["authenticated", "public", "restricted"]},
    "identity_delivery": {"enum": ["none", "optional", "required"]},
    "catalogue_visibility": {"enum": ["listed", "unlisted"]},
    "catalogue_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^<>\\u0000-\\u001F\\u007F]+$"
    },
    "catalogue_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^<>\\u0000-\\u001F\\u007F]+$"
    },
    "attachment_id": {"$ref": "#/$defs/attachmentId"},
    "mount_path": {"const": "/"},
    "forwarding_mode": {"$ref": "#/$defs/forwardingMode"},
    "additional_attachment_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "uniqueItems": true,
      "description": "Complete additional bindings sorted by attachment_id.",
      "items": {"$ref": "#/$defs/additionalAttachmentBinding"}
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["access_mode", "identity_delivery"],
      "properties": {"access_mode": {"const": "public"}, "identity_delivery": {"const": "none"}}
    },
    {
      "type": "object",
      "required": ["access_mode", "identity_delivery"],
      "properties": {"access_mode": {"const": "public"}, "identity_delivery": {"const": "optional"}}
    },
    {
      "type": "object",
      "required": ["access_mode", "identity_delivery"],
      "properties": {"access_mode": {"const": "authenticated"}, "identity_delivery": {"const": "required"}}
    },
    {
      "type": "object",
      "required": ["access_mode", "identity_delivery"],
      "properties": {"access_mode": {"const": "restricted"}, "identity_delivery": {"const": "required"}}
    }
  ],
  "$defs": {
    "applicationId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9-]{1,61}[a-z0-9]$"
    },
    "attachmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "mountPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?:/|(?:/[a-z0-9][a-z0-9_-]{0,62})+)$"
    },
    "forwardingMode": {
      "enum": ["preserve", "strip_application_prefix", "strip_attachment_mount"]
    },
    "additionalAttachmentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachment_id", "mount_path", "forwarding_mode"],
      "properties": {
        "attachment_id": {"$ref": "#/$defs/attachmentId"},
        "mount_path": {"$ref": "#/$defs/mountPath"},
        "forwarding_mode": {"$ref": "#/$defs/forwardingMode"}
      }
    }
  }
}
