{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:comfforts:app-platform:schema:verified-identity-context:v2",
  "title": "Verified Identity Context Version 2",
  "description": "The minimal application-bound visitor identity. platform_member may appear only as a positive current-visitor projection; absence makes no membership claim. This schema does not verify a signature.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "issuer",
    "subject",
    "audience",
    "issued_at",
    "expires_at",
    "correlation_id"
  ],
  "properties": {
    "contract_version": {"const": 2},
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u001F\\u007F]{1,500}$"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F]+$"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]{0,511}$"
    },
    "issued_at": {"type": "integer", "minimum": 0, "maximum": 253402300799},
    "expires_at": {"type": "integer", "minimum": 1, "maximum": 253402300799},
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "platform_member": {"const": true}
  }
}
