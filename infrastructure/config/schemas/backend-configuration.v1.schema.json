{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:comfforts:app-platform:infrastructure-config:backend:v1",
  "title": "Backend Configuration Version 1",
  "description": "Non-secret configuration for the independent AP-M7 backend state owners.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "configuration_kind",
    "configuration_class",
    "project_id",
    "region",
    "state_buckets",
    "recovery_policy"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "configuration_kind": {
      "const": "backend"
    },
    "configuration_class": {
      "enum": [
        "operator",
        "synthetic"
      ]
    },
    "project_id": {
      "$ref": "#/$defs/projectId"
    },
    "region": {
      "$ref": "#/$defs/region"
    },
    "state_buckets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stateBucket"
      }
    },
    "recovery_policy": {
      "$ref": "#/$defs/recoveryPolicy"
    }
  },
  "$defs": {
    "projectId": {
      "type": "string",
      "minLength": 6,
      "maxLength": 30,
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
    },
    "region": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])$"
    },
    "ownerId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9-]{1,61}[a-z0-9]$"
    },
    "bucketName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 63,
      "pattern": "^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$"
    },
    "backendPrefix": {
      "type": "string",
      "minLength": 8,
      "maxLength": 96,
      "pattern": "^(?:platform|fixtures/[a-z][a-z0-9-]{1,61}[a-z0-9])$"
    },
    "stateBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_owner",
        "owner_id",
        "bucket_name",
        "backend_prefix"
      ],
      "properties": {
        "state_owner": {
          "enum": [
            "platform",
            "application"
          ]
        },
        "owner_id": {
          "$ref": "#/$defs/ownerId"
        },
        "bucket_name": {
          "$ref": "#/$defs/bucketName"
        },
        "backend_prefix": {
          "$ref": "#/$defs/backendPrefix"
        }
      }
    },
    "recoveryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noncurrent_version_retention_days",
        "newer_versions_to_retain"
      ],
      "properties": {
        "noncurrent_version_retention_days": {
          "type": "integer",
          "minimum": 90,
          "maximum": 365
        },
        "newer_versions_to_retain": {
          "type": "integer",
          "minimum": 20,
          "maximum": 50
        }
      }
    }
  }
}
