{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:comfforts:app-platform:infrastructure-config:operator-input-manifest:v1",
  "title": "AP-M8 Operator Input Manifest Version 1",
  "description": "One append-only non-secret operator-input revision for the non-production qualification environment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "configuration_kind",
    "configuration_class",
    "manifest_id",
    "revision",
    "predecessor_manifest_digest",
    "approval_reference",
    "source",
    "environment",
    "repository_controls",
    "federation",
    "state",
    "platform_resources",
    "registration_inputs",
    "generated_facts"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "configuration_kind": {
      "const": "operator-input-manifest"
    },
    "configuration_class": {
      "enum": [
        "operator",
        "synthetic"
      ]
    },
    "manifest_id": {
      "const": "ap-m8-qualification-deployment"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "predecessor_manifest_digest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "approval_reference": {
      "$ref": "#/$defs/approvalReference"
    },
    "source": {
      "$ref": "#/$defs/sourceBinding"
    },
    "environment": {
      "$ref": "#/$defs/qualificationEnvironment"
    },
    "repository_controls": {
      "$ref": "#/$defs/repositoryControls"
    },
    "federation": {
      "$ref": "#/$defs/federation"
    },
    "state": {
      "$ref": "#/$defs/statePlan"
    },
    "platform_resources": {
      "$ref": "#/$defs/platformResources"
    },
    "registration_inputs": {
      "$ref": "#/$defs/registrationInputs"
    },
    "generated_facts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/generatedFact"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "numericIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[1-9][0-9]{0,31}$"
    },
    "canonicalName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,126}[A-Za-z0-9]$"
    },
    "resourceName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{1,510}[A-Za-z0-9]$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 5,
      "maxLength": 256,
      "pattern": "^(?:\\.github/workflows|registrations/qualification)/[a-z0-9][a-z0-9._/-]*[a-z0-9]$"
    },
    "bucketName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 63,
      "pattern": "^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$"
    },
    "backendPrefix": {
      "type": "string",
      "minLength": 8,
      "maxLength": 96,
      "pattern": "^(?:bootstrap|platform|fixtures/(?:fixture-public|fixture-authenticated|fixture-restricted))$"
    },
    "serviceAccountResource": {
      "type": "string",
      "minLength": 70,
      "maxLength": 256,
      "pattern": "^projects/comfforts-platform-non-prod/serviceAccounts/[a-z][a-z0-9-]{4,28}[a-z0-9]@comfforts-platform-non-prod\\.iam\\.gserviceaccount\\.com$"
    },
    "impersonationPrincipal": {
      "type": "string",
      "minLength": 80,
      "maxLength": 512,
      "pattern": "^principalSet://iam\\.googleapis\\.com/projects/455651441682/locations/global/workloadIdentityPools/[a-z][a-z0-9-]{1,30}[a-z0-9]/attribute\\.[a-z_]+/[A-Za-z0-9._:/@+-]+$"
    },
    "permission": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[A-Za-z0-9_]+)+$"
    },
    "approvalReference": {
      "type": "string",
      "minLength": 12,
      "maxLength": 256,
      "pattern": "^owner-approval:[A-Za-z0-9][A-Za-z0-9._:/-]{9,240}[A-Za-z0-9]$"
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "repository_id",
        "repository_owner",
        "repository_owner_id",
        "protected_main_ref",
        "source_revision"
      ],
      "properties": {
        "repository": {
          "const": "comfforts/apps-platform"
        },
        "repository_id": {
          "$ref": "#/$defs/numericIdentifier"
        },
        "repository_owner": {
          "const": "comfforts"
        },
        "repository_owner_id": {
          "$ref": "#/$defs/numericIdentifier"
        },
        "protected_main_ref": {
          "const": "refs/heads/main"
        },
        "source_revision": {
          "$ref": "#/$defs/sourceRevision"
        }
      }
    },
    "qualificationEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_id",
        "project_id",
        "project_number",
        "region",
        "hostname"
      ],
      "properties": {
        "environment_id": {
          "const": "qualification"
        },
        "project_id": {
          "const": "comfforts-platform-non-prod"
        },
        "project_number": {
          "const": "455651441682"
        },
        "region": {
          "const": "us-west1"
        },
        "hostname": {
          "const": "apps-staging.comfforts.com"
        }
      }
    },
    "protectedEnvironments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan",
        "apply",
        "dns",
        "evidence",
        "recovery"
      ],
      "properties": {
        "plan": {
          "$ref": "#/$defs/canonicalName"
        },
        "apply": {
          "$ref": "#/$defs/canonicalName"
        },
        "dns": {
          "$ref": "#/$defs/canonicalName"
        },
        "evidence": {
          "$ref": "#/$defs/canonicalName"
        },
        "recovery": {
          "$ref": "#/$defs/canonicalName"
        }
      }
    },
    "workflowReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "target_id",
        "environment_class",
        "workflow_path"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "target_id": {
          "$ref": "#/$defs/canonicalName"
        },
        "environment_class": {
          "$ref": "#/$defs/environmentClass"
        },
        "workflow_path": {
          "$ref": "#/$defs/repositoryPath"
        }
      }
    },
    "repositoryControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protected_environments",
        "workflow_references"
      ],
      "properties": {
        "protected_environments": {
          "$ref": "#/$defs/protectedEnvironments"
        },
        "workflow_references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/workflowReference"
          }
        }
      }
    },
    "environmentClass": {
      "enum": [
        "plan",
        "apply",
        "dns",
        "evidence",
        "recovery"
      ]
    },
    "operation": {
      "enum": [
        "plan",
        "apply",
        "artifact-publish",
        "generation-publish",
        "qualification-dns",
        "root-readback",
        "evidence-finalize",
        "rollback",
        "force-unlock",
        "destroy"
      ]
    },
    "operationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "target_id",
        "environment_class",
        "workflow_path",
        "service_account_resource",
        "impersonation_principal",
        "permissions",
        "resource_scopes"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "target_id": {
          "$ref": "#/$defs/canonicalName"
        },
        "environment_class": {
          "$ref": "#/$defs/environmentClass"
        },
        "workflow_path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "service_account_resource": {
          "$ref": "#/$defs/serviceAccountResource"
        },
        "impersonation_principal": {
          "$ref": "#/$defs/impersonationPrincipal"
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/permission"
          }
        },
        "resource_scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/resourceName"
          }
        }
      }
    },
    "federation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pool_resource",
        "provider_resource",
        "provider_audience",
        "operation_identities"
      ],
      "properties": {
        "pool_resource": {
          "$ref": "#/$defs/resourceName"
        },
        "provider_resource": {
          "$ref": "#/$defs/resourceName"
        },
        "provider_audience": {
          "$ref": "#/$defs/resourceName"
        },
        "operation_identities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/operationIdentity"
          }
        }
      }
    },
    "bucketRole": {
      "enum": [
        "platform-state",
        "fixture-public-state",
        "fixture-authenticated-state",
        "fixture-restricted-state"
      ]
    },
    "stateBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket_role",
        "bucket_name"
      ],
      "properties": {
        "bucket_role": {
          "$ref": "#/$defs/bucketRole"
        },
        "bucket_name": {
          "$ref": "#/$defs/bucketName"
        }
      }
    },
    "rootTarget": {
      "enum": [
        "bootstrap",
        "platform",
        "fixture-public",
        "fixture-authenticated",
        "fixture-restricted"
      ]
    },
    "stateLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_target",
        "bucket_role",
        "backend_prefix",
        "access_binding_reference"
      ],
      "properties": {
        "root_target": {
          "$ref": "#/$defs/rootTarget"
        },
        "bucket_role": {
          "$ref": "#/$defs/bucketRole"
        },
        "backend_prefix": {
          "$ref": "#/$defs/backendPrefix"
        },
        "access_binding_reference": {
          "$ref": "#/$defs/canonicalName"
        }
      }
    },
    "recoveryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noncurrent_version_retention_days",
        "newer_versions_to_retain"
      ],
      "properties": {
        "noncurrent_version_retention_days": {
          "type": "integer",
          "minimum": 90,
          "maximum": 365
        },
        "newer_versions_to_retain": {
          "type": "integer",
          "minimum": 20,
          "maximum": 50
        }
      }
    },
    "statePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buckets",
        "lineages",
        "recovery_policy"
      ],
      "properties": {
        "buckets": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stateBucket"
          }
        },
        "lineages": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stateLineage"
          }
        },
        "recovery_policy": {
          "$ref": "#/$defs/recoveryPolicy"
        }
      }
    },
    "secretVersion": {
      "type": "string",
      "minLength": 70,
      "maxLength": 512,
      "pattern": "^projects/(?:comfforts-platform-non-prod|455651441682)/secrets/[A-Za-z][A-Za-z0-9_-]{0,254}/versions/[1-9][0-9]{0,18}$"
    },
    "httpsUri": {
      "type": "string",
      "minLength": 9,
      "maxLength": 512,
      "pattern": "^https://[A-Za-z0-9.-]+(?:/[A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$"
    },
    "platformResources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_bucket",
        "log_bucket",
        "evidence_bucket",
        "artifact_repository",
        "signing_key_resource",
        "managed_zone_resource",
        "dns_record_name",
        "oauth_client_id",
        "oauth_redirect_uri",
        "oauth_client_secret_version",
        "billing_account_reference",
        "notification_destination",
        "evidence_bundle_prefix"
      ],
      "properties": {
        "configuration_bucket": {
          "$ref": "#/$defs/bucketName"
        },
        "log_bucket": {
          "$ref": "#/$defs/bucketName"
        },
        "evidence_bucket": {
          "$ref": "#/$defs/bucketName"
        },
        "artifact_repository": {
          "$ref": "#/$defs/resourceName"
        },
        "signing_key_resource": {
          "$ref": "#/$defs/resourceName"
        },
        "managed_zone_resource": {
          "$ref": "#/$defs/resourceName"
        },
        "dns_record_name": {
          "const": "apps-staging.comfforts.com."
        },
        "oauth_client_id": {
          "$ref": "#/$defs/resourceName"
        },
        "oauth_redirect_uri": {
          "$ref": "#/$defs/httpsUri"
        },
        "oauth_client_secret_version": {
          "$ref": "#/$defs/secretVersion"
        },
        "billing_account_reference": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^billingAccounts/[0-9A-F]{6}-[0-9A-F]{6}-[0-9A-F]{6}$"
        },
        "notification_destination": {
          "$ref": "#/$defs/resourceName"
        },
        "evidence_bundle_prefix": {
          "type": "string",
          "minLength": 30,
          "maxLength": 256,
          "pattern": "^ap-eval-m8/[0-9a-f]{40}/[A-Za-z0-9][A-Za-z0-9._-]{1,126}[A-Za-z0-9]/$"
        }
      }
    },
    "applicationId": {
      "enum": [
        "fixture-public",
        "fixture-authenticated",
        "fixture-restricted"
      ]
    },
    "registrationInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registration_set_path",
        "restricted_members_source",
        "application_ids"
      ],
      "properties": {
        "registration_set_path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "restricted_members_source": {
          "$ref": "#/$defs/repositoryPath"
        },
        "application_ids": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/applicationId"
          }
        }
      }
    },
    "generatedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_kind",
        "target_id",
        "value"
      ],
      "properties": {
        "fact_kind": {
          "enum": [
            "image-digest",
            "state-lineage-digest",
            "configuration-object-generation",
            "plan-digest",
            "workflow-run-id"
          ]
        },
        "target_id": {
          "$ref": "#/$defs/canonicalName"
        },
        "value": {
          "$ref": "#/$defs/resourceName"
        }
      }
    }
  }
}
