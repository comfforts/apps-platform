{
  "name": "[INERT AP-M7] Explicit Terraform force-unlock",
  "on": {
    "workflow_dispatch": {}
  },
  "permissions": {
    "contents": "read"
  },
  "concurrency": {
    "group": "app-platform-__ROOT_TARGET__",
    "cancel-in-progress": false
  },
  "env": {
    "AP_OPERATION": "force-unlock",
    "AP_REPOSITORY": "comfforts/apps-platform",
    "AP_PROTECTED_MAIN_REF": "refs/heads/main",
    "AP_PROTECTED_ENVIRONMENT": "__PROTECTED_ENVIRONMENT__",
    "AP_PROTECTED_SUBJECT": "repo:comfforts/apps-platform:environment:__PROTECTED_ENVIRONMENT__",
    "AP_SOURCE_REVISION": "__SOURCE_REVISION_40_HEX__",
    "AP_ROOT_TARGET": "__ROOT_TARGET__",
    "AP_LOCK_ID": "__LOCK_ID__",
    "AP_CONFIRMATION_DIGEST": "__CONFIRMATION_DIGEST_SHA256__",
    "AP_BACKEND_CONFIG_FILE": "__BACKEND_CONFIG_FILE__",
    "TF_CLI_CONFIG_FILE": "${{ github.workspace }}/.cache/terraform/offline.tfrc"
  },
  "x-ap-m7-authority": {
    "status": "inert",
    "activation_authority": "AP-M8_REQUIRED",
    "configuration_contract": "urn:comfforts:app-platform:infrastructure-config:workflow:v1",
    "operation": "force-unlock",
    "plan_digest": null,
    "destructive_target": {
      "operation": "force-unlock",
      "root_target": "__ROOT_TARGET__",
      "target_id": "__LOCK_ID__",
      "confirmation_digest": "__CONFIRMATION_DIGEST_SHA256__"
    },
    "plan_storage": "none",
    "stop_on_partial_failure": true,
    "outcome_metadata": [
      "operation",
      "root_target",
      "source_revision",
      "target_id",
      "confirmation_digest",
      "outcome"
    ]
  },
  "jobs": {
    "force-unlock": {
      "name": "INERT template - AP-M8 activation required",
      "if": "${{ github.repository == 'comfforts/apps-platform' && github.ref == 'refs/heads/main' && github.sha == '__SOURCE_REVISION_40_HEX__' }}",
      "environment": "__PROTECTED_ENVIRONMENT__",
      "runs-on": "ubuntu-24.04",
      "timeout-minutes": 20,
      "permissions": {
        "contents": "read",
        "id-token": "write"
      },
      "steps": [
        {
          "name": "Check out the exact reviewed revision",
          "uses": "actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803",
          "with": {
            "ref": "__SOURCE_REVISION_40_HEX__",
            "persist-credentials": false
          }
        },
        {
          "name": "Set up the pinned Python runtime",
          "uses": "actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0",
          "with": {
            "python-version": "3.12.12"
          }
        },
        {
          "name": "Prepare the checksum-pinned Terraform toolchain",
          "run": "set -euo pipefail\nmake terraform-setup"
        },
        {
          "name": "Authenticate with future protected OIDC authority",
          "uses": "google-github-actions/auth@7c6bc770dae815cd3e89ee6cdf493a5fab2cc093",
          "with": {
            "project_id": "__PROJECT_ID__",
            "workload_identity_provider": "__WORKLOAD_IDENTITY_PROVIDER__",
            "service_account": "__OPERATION_SERVICE_ACCOUNT__",
            "create_credentials_file": "true",
            "export_environment_variables": "true"
          }
        },
        {
          "name": "Verify exact-main unlock authority",
          "run": "set -euo pipefail\ntest \"$GITHUB_REPOSITORY\" = \"$AP_REPOSITORY\"\ntest \"$GITHUB_REF\" = \"$AP_PROTECTED_MAIN_REF\"\ntest \"$GITHUB_SHA\" = \"$AP_SOURCE_REVISION\"\ntest \"$AP_PROTECTED_SUBJECT\" = \"repo:${AP_REPOSITORY}:environment:${AP_PROTECTED_ENVIRONMENT}\""
        },
        {
          "name": "Resolve the explicit state root",
          "id": "root",
          "run": "set -euo pipefail\ncase \"$AP_ROOT_TARGET\" in\n  bootstrap) root=\"infrastructure/terraform/bootstrap\" ;;\n  platform) root=\"infrastructure/terraform/platform\" ;;\n  fixture-public) root=\"infrastructure/terraform/fixtures/fixture-public\" ;;\n  fixture-authenticated) root=\"infrastructure/terraform/fixtures/fixture-authenticated\" ;;\n  fixture-restricted) root=\"infrastructure/terraform/fixtures/fixture-restricted\" ;;\n  *) exit 1 ;;\nesac\nprintf 'directory=%s\\n' \"$root\" >> \"$GITHUB_OUTPUT\""
        },
        {
          "name": "Initialize the selected backend",
          "working-directory": "${{ steps.root.outputs.directory }}",
          "run": "set -euo pipefail\ntest \"$AP_ROOT_TARGET\" != bootstrap\ntf=\"$GITHUB_WORKSPACE/.cache/terraform/bin/terraform\"\n\"$tf\" init -input=false -lockfile=readonly -backend-config=\"$GITHUB_WORKSPACE/$AP_BACKEND_CONFIG_FILE\""
        },
        {
          "name": "Verify the exact destructive target",
          "run": "set -euo pipefail\nmaterial=\"${AP_OPERATION}|${AP_ROOT_TARGET}|${AP_LOCK_ID}|${AP_SOURCE_REVISION}\"\nconfirmation_digest=\"sha256:$(printf '%s' \"$material\" | sha256sum | awk '{print $1}')\"\ntest \"$confirmation_digest\" = \"$AP_CONFIRMATION_DIGEST\""
        },
        {
          "name": "Force-unlock only the confirmed lock",
          "id": "unlock",
          "working-directory": "${{ steps.root.outputs.directory }}",
          "run": "set -euo pipefail\ntf=\"$GITHUB_WORKSPACE/.cache/terraform/bin/terraform\"\n\"$tf\" force-unlock -force \"$AP_LOCK_ID\""
        },
        {
          "name": "Record secret-free force-unlock outcome metadata",
          "if": "${{ always() }}",
          "run": "printf 'operation=%s\\nroot_target=%s\\nsource_revision=%s\\ntarget_id=%s\\nconfirmation_digest=%s\\noutcome=%s\\n' \"$AP_OPERATION\" \"$AP_ROOT_TARGET\" \"$AP_SOURCE_REVISION\" \"$AP_LOCK_ID\" \"$AP_CONFIRMATION_DIGEST\" \"${{ steps.unlock.outcome }}\" >> \"$GITHUB_STEP_SUMMARY\""
        }
      ]
    }
  }
}
